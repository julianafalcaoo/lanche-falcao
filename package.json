{
  "name": "lanche-falcao",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:check": "node --conditions=react-server --env-file=.env scripts/check-db.mjs",
    "test:identificacao": "node --conditions=react-server --env-file=.env --test tests/identificacao.test.mjs",
    "test:otp": "node --conditions=react-server --test tests/otp.test.mjs",
    "test:auth": "node --conditions=react-server --env-file=.env scripts/test-auth.mjs",
    "test:checkout": "playwright test",
    "test:pedidos": "node --conditions=react-server --env-file=.env scripts/test-auth.mjs pedidos",
    "test": "npm run test:identificacao && npm run test:otp && npm run test:auth && npm run test:pedidos"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.4",
    "libphonenumber-js": "^1.13.14",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  }
}
