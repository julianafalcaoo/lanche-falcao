generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model LimiteOtp {
  chave      String   @id @db.Char(64)
  quantidade Int
  expiraEm   DateTime

  @@index([expiraEm])
}

model Cliente {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome               String
  telefone           String   @unique
  telefoneVerificado Boolean  @default(false)
  criadoEm           DateTime @default(now())
  atualizadoEm       DateTime @default(now()) @updatedAt
  sessoes            Sessao[]
  pedidos            Pedido[]
}

enum EstadoDesafioOtp {
  PENDENTE
  PROCESSANDO
  CONSUMIDO
  INVALIDADO
}

model DesafioOtp {
  id        String @id @db.VarChar(64)
  nome      String @db.VarChar(100)
  telefone  String
  pinId     String @unique
  estado    EstadoDesafioOtp @default(PENDENTE)
  criadoEm  DateTime @default(now())
  expiraEm  DateTime
  consumidoEm DateTime?

  @@index([expiraEm])
}

model Sessao {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String @unique @db.Char(64)
  clienteId String @db.Uuid
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  criadoEm  DateTime @default(now())
  expiraEm  DateTime

  @@index([clienteId])
  @@index([expiraEm])
}

enum TipoPedido {
  RETIRADA
  ENTREGA
}

enum StatusPedido {
  PEDIDO_RECEBIDO
  EM_PREPARACAO
  PRONTO
  SAIU_PARA_ENTREGA
  ENTREGUE
  PRONTO_PARA_RETIRADA
  RETIRADO
}

enum FormaPagamento {
  PIX
  DINHEIRO
  CARTAO
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
  CANCELADO
  ESTORNADO
  ESTORNADO_PARCIAL
  CONTESTADO
}

model Pedido {
  id                 String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId          String @db.Uuid
  cliente            Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  tipo               TipoPedido
  status             StatusPedido @default(PEDIDO_RECEBIDO)
  subtotalCentavos   Int
  totalCentavos      Int
  formaPagamento     FormaPagamento?
  statusPagamento    StatusPagamento @default(PENDENTE)
  precisaTroco       Boolean?
  trocoParaCentavos  Int?
  chaveIdempotencia  String @db.Uuid
  requisicaoHash     String @db.Char(64)
  entregaCep         String? @db.VarChar(8)
  entregaRua         String? @db.VarChar(200)
  entregaNumero      String? @db.VarChar(200)
  entregaBairro      String? @db.VarChar(200)
  entregaCidade      String? @db.VarChar(200)
  entregaUf          String? @db.VarChar(2)
  entregaComplemento String? @db.VarChar(200)
  entregaReferencia  String? @db.VarChar(200)
  criadoEm           DateTime @default(now())
  atualizadoEm       DateTime @default(now()) @updatedAt
  itens              ItemPedido[]
  tentativasPagamento TentativaPagamento[]

  @@unique([clienteId, chaveIdempotencia])
  @@index([clienteId, criadoEm(sort: Desc), id(sort: Desc)])
}

model TentativaPagamento {
  id                 String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedidoId           String @db.Uuid
  pedido             Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  chaveCliente       String @db.Uuid
  chaveProvedor      String @unique @db.Uuid
  requisicaoHash     String @db.Char(64)
  orderId            String? @unique @db.VarChar(64)
  statusExterno      String? @db.VarChar(80)
  detalheExterno     String? @db.VarChar(100)
  statusLocal        StatusPagamento?
  metodoExterno      String? @db.VarChar(40)
  tipoMetodoExterno  String? @db.VarChar(40)
  reconciliadaEm     DateTime?
  atualizadaNoProvedor String? @db.VarChar(40)
  encerrada          Boolean @default(false)
  envios             Int @default(0)
  bloqueadaAte       DateTime?
  codigoErro         String? @db.VarChar(80)
  qrCode             String?
  qrCodeBase64       String?
  ticketUrl          String?
  criadoEm           DateTime @default(now())
  atualizadoEm       DateTime @default(now()) @updatedAt

  @@unique([pedidoId, chaveCliente])
  @@index([pedidoId, criadoEm])
}

// Apenas identificadores autenticados e diagnóstico seguro; nunca o payload recebido.
model WebhookOrder {
  id                String @id @db.Char(64)
  orderId           String @db.VarChar(64)
  criadoEm          DateTime @default(now())
  processadoEm      DateTime?
  proximaExecucaoEm DateTime @default(now())
  reservaToken      String? @db.Uuid
  reservadaAte      DateTime?
  tentativas        Int @default(0)
  codigoErro        String? @db.VarChar(80)

  @@index([processadoEm, proximaExecucaoEm])
}

model ItemPedido {
  id                    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedidoId              String @db.Uuid
  pedido                Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId             String @db.VarChar(100)
  nomeProduto           String @db.VarChar(200)
  precoUnitarioCentavos  Int
  quantidade            Int
  subtotalCentavos      Int

  @@unique([pedidoId, produtoId])
}
