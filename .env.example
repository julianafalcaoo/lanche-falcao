# Exemplo SEM credenciais. Não copie o .env local para Vercel/Neon.
# Runtime: URL com pooling e TLS do banco exclusivo deste ambiente.
DATABASE_URL=
# CLI Prisma: URL direta do MESMO banco. Opcional somente no desenvolvimento local.
DIRECT_URL=
# Pool por instância: padrão 3 em production; 10 em desenvolvimento.
DATABASE_POOL_MAX=3

# Infobip: aplicação e template exclusivos de homologação.
INFOBIP_API_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_2FA_APPLICATION_ID=
INFOBIP_2FA_MESSAGE_ID=
# Telefones brasileiros autorizados, separados por vírgula. Obrigatório na Vercel.
# Não substitui rate limiting nem os limites de envio/tentativas da Infobip.
INFOBIP_ALLOWED_PHONES=

# Mercado Pago: somente credenciais e pagadores de TESTE. Produção segue bloqueada.
MERCADO_PAGO_AMBIENTE=test
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
# POST de agendador externo: segredo independente, enviado como Bearer.
MERCADO_PAGO_RECONCILIACAO_SECRET=
# GET do Vercel Cron: outro segredo, enviado automaticamente como Bearer.
CRON_SECRET=

# VERCEL, VERCEL_ENV e NODE_ENV são definidos pela plataforma; não cadastrar manualmente.
# Nenhuma variável deste projeto precisa de prefixo NEXT_PUBLIC_.
